---
const rows = [
  { l: 'Your preferences', r: 'Explicit stance selections', why: 'user → project → session', href: '/stances/' },
  { l: 'Shared primitives', r: 'Rules · skills · roles · workflows', why: 'one authoring authority', href: '/docs/how-it-works/' },
  { l: 'Runtime adapters', r: 'Native instructions and controls', why: 'capability differences stay visible', href: '/compatibility/' },
  { l: 'Claude Code · Codex', r: 'CLI · editor · desktop', why: 'qualification is per client and platform', href: '/compatibility/' },
];
---
<ol class="ladder" aria-label="Shared primitives and runtime projections">
  {rows.map((row) => <li><a href={row.href}><span class="l">{row.l}</span><span class="g" aria-hidden="true">→</span><span class="r">{row.r}</span><span class="why">{row.why}</span></a></li>)}
</ol>
